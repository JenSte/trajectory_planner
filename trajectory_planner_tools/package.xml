<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>trajectory_planner_tools</name>
    <version>0.0.1</version>
    <description>Debug/development tools and example launch/configuration files for the trajectory planner.</description>
    <maintainer email="jens.steinhauser@gmail.com">Jens Steinhauser</maintainer>
    <license>MIT</license>

    <buildtool_depend>ament_cmake</buildtool_depend>
    <!--
    <buildtool_depend>ament_cmake_python</buildtool_depend>
    -->

    <depend>rclpy</depend>
    <depend>trajectory_planner_msgs</depend>
    <depend>launch_ros</depend>

    <exec_depend>trajectory_planner</exec_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
