<launch>
    <!--
        Loads the map and starts the navigation stack.
    -->

    <arg
        name="map_name"
        value="cave_2cm.yaml"
        doc="The map to load."
    />

    <node
        name="map_server"
        pkg="map_server"
        type="map_server"
        output="screen"
        args="$(find trajectory_planner_tools)/../map/$(arg map_name)"
    />

    <node
        name="move_base"
        pkg="move_base"
        type="move_base"
        output="screen"
    >
        <rosparam
            file="$(find trajectory_planner_tools)/config/navigation.yaml"
            command="load"
        />
    </node>
</launch>
