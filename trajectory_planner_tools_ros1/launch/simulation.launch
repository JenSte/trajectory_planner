<launch>
    <!--
        Start the navigation in a Gazeboo simulation.
    -->

    <param name="/use_sim_time" value="true"/>

    <include
        file="$(find tuw_gazebo_models)/launch/room_world.launch"/>

    <include
        file="$(find tuw_gazebo_models)/launch/pioneer3dx/pioneer3dx.gazebo.launch">
        <arg name="robot_name" value="/"/>
        <arg name="position" value="-x 3.0 -y 5.0 -z 0.01"/>
        <arg name="launch_ground_truth_robot_state_publisher" value="false"/>
    </include>

    <include
        file="$(find trajectory_planner_tools)/launch/navigation.launch"/>

    <node
        pkg="fake_localization"
        type="fake_localization"
        name="fake_localization">
        <remap from="base_pose_ground_truth" to="odom"/>
    </node>
</launch>
