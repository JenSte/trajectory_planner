<package format="2">
    <name>trajectory_planner</name>
    <version>0.0.1</version>
    <description>A global planner for mobile robots that takes the vehicle's motion model into account - move_base plugin</description>
    <maintainer email="jens.steinhauser@gmail.com">Jens Steinhauser</maintainer>
    <license>MIT</license>

    <buildtool_depend>catkin</buildtool_depend>

    <depend>costmap_2d</depend>
    <depend>geometry_msgs</depend>
    <depend>nav_core</depend>
    <depend>nav_msgs</depend>
    <depend>pluginlib</depend>
    <depend>rosconsole</depend>
    <depend>roscpp</depend>
    <depend>sensor_msgs</depend>
    <depend>tf2_ros</depend>

    <export>
        <nav_core plugin="${prefix}/trajectory_planner_plugin.xml"/>
    </export>
</package>
